exports[`modules/twinklespeedy Twinkle.speedy global variables Should match snapshot 7`] = `
[
  {
    "code": "u1",
    "hideSubgroupWhenMultiple": true,
    "label": "U1: User requested deletion in own user space",
    "subgroup": null,
    "tooltip": "User requested deletion of their own user page or user-subpage. User pages that are blanked by the user may also be deleted under this criterion.",
    "value": "userspacereq",
  },
  {
    "code": "u2",
    "hideWhenRedirect": true,
    "label": "U2: Nonexistent user",
    "tooltip": "User space of non-existent user. Redirects may be created (and protected) for those user names of which the account was renamed.",
    "value": "nouser",
  },
  {
    "code": "u3",
    "hideWhenRedirect": true,
    "label": "U3: Inappropriate use of user pages",
    "subgroup": {
      "label": "Optional explanation: ",
      "name": "inappuser_rationale",
      "parameter": "2",
      "size": 60,
      "type": "input",
    },
    "tooltip": "Inappropriate use of user pages. These include user pages that contain purely advertising or promotional material, or those that are created with the intention of harassment or attack. Those that contain gibberish or unrecognisable content may also be deleted under this criterion.",
    "value": "inappuserspace",
  },
]
`;

exports[`modules/twinklespeedy Twinkle.speedy global variables Should match snapshot 8`] = `
[
  {
    "code": "g1",
    "hideInNamespaces": [
      2,
    ],
    "label": "G1: Test page, accidental creation, or page containing nonsense or no valid content",
    "tooltip": "Page contains redundant content that was previously used for testing, was accidentally created, or contains content that is gibberish or of nothing meaningful. This may also include text placed in talk pages (which has no further history) that doesn't help or refer to the related page.",
    "value": "g1",
  },
  {
    "code": "g2",
    "label": "G2: Unused and implausible, or broken redirect",
    "tooltip": "Page is an unused AND implausible redirect, or a redirect that is dependent on deleted or non-existent content. Unused talk page redirects created as a result of a page move and cross-namespace redirects may also be deleted under this criterion.",
    "value": "redir",
  },
  {
    "code": "g3",
    "label": "G3: Content intended as vandalism, threat, attack, or hoax",
    "subgroup": {
      "label": "Optional explanation: ",
      "name": "vandalism_rationale",
      "parameter": "2",
      "size": 60,
      "type": "input",
    },
    "tooltip": "Content that is posted with the intention of vandalizing, or with the intention of threatening, harassing, or attacking another person or user. Users that commit such acts are subjected to their accounts being temporarily or permanently blocked, depending on the severity of the content. Content posted with the intention of creating/spreading hoaxes may also be deleted under this criterion.",
    "value": "vandalism",
  },
  {
    "code": "g4",
    "label": "G4: Recreation of material deleted via a deletion discussion",
    "subgroup": {
      "label": "Page where the deletion discussion took place: ",
      "name": "repost_xfd",
      "parameter": "2",
      "size": 60,
      "tooltip": "Must start with "Commons:"",
      "type": "input",
    },
    "tooltip": "Page or file matches content that was previously deleted per community consensus. Repeated recreation of such content may lead to the user's account being blocked. The author or uploader may ask the deleting administrator to restore the file, or file an Undeletion Request.",
    "value": "repost",
  },
  {
    "code": "g6",
    "label": "G6: Uncontroversial maintenance",
    "subgroup": {
      "label": "Optional explanation. If this is for a move, include the page name for the page to be moved here and the reason. Otherwise, explain why this should be deleted: ",
      "name": "g6_rationale",
      "parameter": "2",
      "size": 60,
      "type": "input",
    },
    "tooltip": "Content temporarily deleted to make way for a page move, or other uncontroversial maintenance tasks that require temporary or permanent deletion (such as history merging or splitting).",
    "value": "g6",
  },
  {
    "code": "g7",
    "label": "G7: Author or uploader request deletion of RECENT content",
    "subgroup": {
      "label": "Optional explanation: ",
      "name": "author_rationale",
      "parameter": "2",
      "size": 60,
      "tooltip": "Perhaps linking to where the author requested this deletion.",
      "type": "input",
    },
    "tooltip": "Original author or uploader requests deletion of recently created (<7 days) unused content. For author/uploader requests for deletion of content that is older a deletion request should be filed instead. If the author blanks the page, this can also be taken as a deletion request.",
    "value": "author",
  },
  {
    "code": "g8",
    "hideSubgroupWhenSysop": true,
    "label": "G8: Page dependent on deleted or non-existent content",
    "subgroup": {
      "label": "Optional explanation: ",
      "name": "g8_rationale",
      "parameter": "2",
      "size": 60,
      "type": "input",
    },
    "tooltip": "The page or file depends on content that was deleted or no longer existing, such as orphaned talk pages without useful content, subpages without parent page, and so on. The criterion only applies to content within Wikimedia, and does not apply to external content (i.e., deleted source).",
    "value": "g8",
  },
  {
    "code": "g10",
    "label": "G10: Files and pages created as advertisements",
    "subgroup": {
      "label": "Optional explanation: ",
      "name": "advert_rationale",
      "parameter": "2",
      "size": 60,
      "type": "input",
    },
    "tooltip": "This includes only content uploaded to promote goods and services when it is clearly not useful for any educational purpose (see Commons:Project scope). Files that illustrate contemporary or historical advertisements do not fall under this criterion.",
    "value": "advert",
  },
  {
    "code": "g11",
    "label": "G11: Blatant text copyright violation",
    "subgroup": [
      {
        "label": "Deletion rationale for copyvios. Include the URL or source of the copyvio: ",
        "name": "textcopyvio_rationale",
        "parameter": "2",
        "size": 60,
        "type": "input",
      },
    ],
    "tooltip": "Page contains copyrighted text from webpages or documents without permission.",
    "value": "textcopyvio",
  },
]
`;

